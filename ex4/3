#include <sys/wait.h>

int main(){
   int shmid, *buf;
   int i, num, size = 10;
   
   shmid = shmget(4777, sizeof(int) * size, IPC_CREAT | 0666);
   printf("==========PARENTCHILD PROGRAM=========");
   
   if(shmid == -1){
      perror("shmget");
      return 1;
   }
   
   buf = (int *)shmat(shmid, NULL, 0);
   
   if(buf == (void *)-1){
      perror("shmat");
      return 1;
   }
   
   pid_t pid = fork();
   
   if(pid < 0){
      perror("fork");
      return 1;
   }
   
   if(pid == 0){

      printf("Producer Child Process\n");
      
      for(i = 0; i < size; i++){
	 printf("Enter data %d : ", i + 1);
	 scanf("%d", &num);
	 buf[i] = num;
      }
      
      shmdt(buf);
   }
   
   else{

      wait(NULL);

      printf("Consumer Parent Process\n");
      
      for(i = 0; i < size; i++){
	 printf("data[%d] = %d\n", i + 1, buf[i]);
      }
      
      shmdt(buf);
      shmctl(shmid, IPC_RMID, NULL);

    }

    return 0;
}
